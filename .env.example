# PopfileNet Environment Configuration (Development)
# Copy this file as .env and fill in your values

POSTGRES_PASSWORD=changeme

IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=your@email.com
IMAP_PASSWORD=your-password
IMAP_USE_SSL=true
IMAP_MAX_PARALLEL_CONNECTIONS=4

SYNC_INTERVAL=00:05:00

# Classifier model persistence
CLASSIFIER_MODELS_ROOT=classifier-models
CLASSIFIER_MAX_CACHED_MODELS=16
CLASSIFIER_CACHE_TTL=00:20:00

DB_HOST=postgres
DB_DATABASE=popfilenet
DB_USERNAME=postgres

ADMIN_EMAIL=admin@popfile.local
ADMIN_PASSWORD=changeme-to-a-secure-password