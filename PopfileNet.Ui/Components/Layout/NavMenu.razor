<div class="top-row ps-3 navbar navbar-dark" data-testid="navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="" data-testid="navbar-brand">PopfileNet.Ui</a>
    </div>
</div>

@using PopfileNet.Ui.Services

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>  

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="accounts">
                <span class="bi bi-envelope-nav-menu" aria-hidden="true"></span> Accounts
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mails">
                <span class="bi bi-envelope-open-nav-menu" aria-hidden="true"></span> Mails
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sync">
                <span class="bi bi-arrow-repeat-nav-menu" aria-hidden="true"></span> Sync
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="classify">
                <span class="bi bi-tags-nav-menu" aria-hidden="true"></span> Classify
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-gear-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>

        @if (devMode)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="evaluate">
                    <span class="bi bi-bar-chart-nav-menu" aria-hidden="true"></span> Evaluate
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool devMode = false;
    [Inject] private IApiClient Api { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        devMode = await Api.GetDevModeStatusAsync() ?? false;
    }
}
